# Copia este archivo como .env y completa con los datos de Supabase > Project Settings > API.
# La clave "anon" es pública por diseño: la seguridad la dan las reglas RLS de supabase/schema.sql.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON
# 1 para mostrar "Continuar con Google" (antes actívalo en Supabase > Authentication > Providers).
GOOGLE=0
